    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n      \"Tag\".\"albumsScrapedAt\",\n      \"Tag\".\"listCheckedAt\",\n      \"Tag\".\"listUpdatedAt\",\n      \"Tag\".\"name\",\n      \"Tag\".\"registeredAt\",\n      SUM(\"AlbumTag\".\"count\"::FLOAT * COALESCE(\"Album\".\"playcount\", 0) / 1000000 * COALESCE(\"Album\".\"listeners\", 0) / 1000)\n      AS \"weight\"\n    FROM \"Tag\"\n    JOIN \"AlbumTag\"\n    ON \"AlbumTag\".\"tagName\" = \"Tag\".\"name\"\n    JOIN \"Album\"\n    ON \"Album\".\"artist\" = \"AlbumTag\".\"albumArtist\" AND\n      \"Album\".\"name\" = \"AlbumTag\".\"albumName\"\n    WHERE \"albumsScrapedAt\" IS NULL AND\n      \"Album\".\"hidden\" <> true\n    GROUP BY \"Tag\".\"name\"\n    ORDER BY \"weight\" DESC\n    LIMIT 1",
        "options": {}
      },
