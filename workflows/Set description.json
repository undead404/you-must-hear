    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \"Tag\".\"name\", SUM(\"Album\".\"listeners\" * \"AlbumTag\".\"count\") AS \"weight\"\nFROM \"Tag\"\nINNER JOIN \"AlbumTag\"\nON \"Tag\".\"name\" = \"AlbumTag\".\"tagName\"\nINNER JOIN \"Album\"\nON \"AlbumTag\".\"albumArtist\" = \"Album\".\"artist\"\nAND \"AlbumTag\".\"albumName\" = \"Album\".\"name\"\nWHERE \"Tag\".\"listUpdatedAt\" IS NOT NULL\nAND \"Tag\".\"description\" IS NULL\nGROUP BY \"Tag\".\"name\"\nORDER BY \"weight\" DESC\nLIMIT 1",
        "options": {}
      },
