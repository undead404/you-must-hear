      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \"artist\", SUM(\"Album\".\"listeners\" * \"AlbumTag\".\"count\" / 100) AS \"weight\"\n  FROM \"Album\"\n  INNER JOIN \"AlbumTag\"\n  ON \"AlbumTag\".\"albumArtist\" = \"Album\".\"artist\"\n  AND \"AlbumTag\".\"albumName\" = \"Album\".\"name\"\n  WHERE \"AlbumTag\".\"tagName\" = '{{ $json.name }}'\n  AND \"Album\".\"listeners\" IS NOT NULL\n  AND \"Album\".\"hidden\" <> TRUE\n  GROUP BY \"artist\"\nORDER BY \"weight\" DESC\nLIMIT 5",
        "options": {}
