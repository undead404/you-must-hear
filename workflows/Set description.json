    {
      "parameters": {
        "jsCode": "function escapeText(text) {\n  return text.replace(/\\_/g, '\\\\_')\n  .replace(/\\*/g, '\\\\*')\n  .replace(/\\[/g, '\\\\[')\n  .replace(/\\]/g, '\\\\]')\n  .replace(/\\(/g, '\\\\(')\n  .replace(/\\)/g, '\\\\)')\n  .replace(/\\~/g, '\\\\~')\n  .replace(/\\`/g, '\\\\`')\n  .replace(/\\>/g, '\\\\>')\n  .replace(/\\#/g, '\\\\#')\n  .replace(/\\+/g, '\\\\+')\n  .replace(/\\-/g, '\\\\-')\n  .replace(/\\=/g, '\\\\=')\n  .replace(/\\|/g, '\\\\|')\n  .replace(/\\{/g, '\\\\{')\n  .replace(/\\}/g, '\\\\}')\n  .replace(/\\./g, '\\\\.')\n  .replace(/\\!/g, '\\\\!');\n}\n\nreturn $input.all().map(item => ({\n  escapedDescription: escapeText(item.json.description),\n  exampleArtists: $('Merge').first().json.data.map(({artist}) => escapeText(artist)),\n  escapedName: escapeText(item.json.name),\n  linkName: item.json.name.replaceAll(' ', '-'),\n}))"
      },
