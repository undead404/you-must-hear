    {
      "parameters": {
        "jsCode": "const Mustache = require('mustache');\n\nconst { data, date, template } = $input.first().json;\n\nconst markdown = Mustache.render(template, {\n  date: date,\n  prettyDate: new Date(date).toString(),\n  tags: data.map(tag => ({\n    date: tag.listUpdatedAt,\n    linkName: tag.name.replaceAll(' ', '-'),\n    name: tag.name,\n    prettyDate: new Date(tag.listUpdatedAt).toString(),\n  })),\n}, {}, [ '<%', '%>' ]);\n\nreturn {markdown};"
      },
