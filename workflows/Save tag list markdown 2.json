    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Add a new field called 'myNewField' to the JSON of the item\n$input.item.json.dateForSort = $input.item.json.date;\n\nif (!$input.item.json.dateForSort || $input.item.json.dateForSort.length < 4) {\n  $input.item.json.dateForSort = '9999-99-99';\n} else {\n  $input.item.json.dateForSort = $input.item.json.dateForSort + '-99'.repeat(($input.item.json.dateForSort.length - 4) / 3);\n}\n\nreturn $input.item;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2032,
        -64
      ],
      "id": "231d1bd6-7a9b-446c-b010-fec7b07522ff",
