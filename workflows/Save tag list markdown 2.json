      "id": "c6e84b4d-c63a-4ca1-b0b1-942c49b931a7",
      "name": "Merge albums with tags"
    },
    {
      "parameters": {
        "jsCode": "const map = new Map();\n\nfor (const item of $input.all()) {\n  const key = item.json.albumArtist + ' - ' + item.json.albumName;\n  const savedItem = map.get(key);\n  if (savedItem) {\n    savedItem.tags[item.json.tagName] = item.json.count;\n  } else {\n    const newItem = {\n      artist: item.json.albumArtist,\n      name: item.json.albumName,\n      tags: {\n        [item.json.tagName]: item.json.count,\n      }\n    }\n    map.set(key, newItem);\n  }\n}\n\nreturn [...map.values()].map((item) => ({\n  ...item,\n  tags: Object.entries(item.tags).toSorted(([,count1],[,count2]) => count2 - count1).map(([tagName, count]) => ({\n    count,\n    linkName: tagName.replaceAll(' ', '-'),\n    tagName,\n  })),\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
