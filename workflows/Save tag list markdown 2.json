    {
      "parameters": {
        "jsCode": "const Mustache = require('mustache');\n\nconst date = $('Begin').first().json.listUpdatedAt;\nconst title = $('Begin').first().json.name;\nconst { data, description, relatedTags, template } = $input.first().json;\n\nconst markdown = Mustache.render(template, {\n  date: date,\n  description: description,\n  linkName: title.replaceAll(' ', '-'),\n  prettyDate: new Date(date).toString(),\n  relatedGenres: relatedTags.map(({tagName}) => ({\n    linkName: tagName.replaceAll(' ', '-'),\n    name: tagName,\n  })),\n  releases: data.map(release => ({\n    artist: release.artist,\n    cover: release.thumbnail,\n    date: release.date,\n    name: release.name,\n    place: release.place,\n    tags: (release.tags || []),\n  })),\n  title: title,\n}, {}, [ '<%', '%>' ]);\n\nreturn {markdown};"
      },
