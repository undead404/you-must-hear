    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \"AlbumTag\".*\nFROM \"AlbumTag\"\nINNER JOIN \"Tag\"\nON \"AlbumTag\".\"tagName\" = \"Tag\".\"name\"\nWHERE \"AlbumTag\".\"albumArtist\" = $1\nAND \"AlbumTag\".\"albumName\" = $2\nAND \"Tag\".\"listUpdatedAt\" IS NOT NULL\nAND \"AlbumTag\".\"count\" > 50",
        "options": {
          "queryReplacement": "={{ $json.artist }},{{ $json.name }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
