    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  let maxCount = 0;\n  for(const tag of item.json.tags) {\n    if (tag.count > maxCount) {\n      maxCount = tag.count;\n    }\n  }\n  return {\n  ...item,\n  json: {\n    ...item.json,\n    tags: item.json.tags.map(tag => ({\n      ...tag,\n      count: tag.count/maxCount * 100,\n      name: tag.name.toLowerCase()\n    }))\n  }\n}});"
      },
